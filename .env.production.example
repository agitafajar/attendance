# Alih Daya Attendance - VPS production env
# Copy this file to /home/ubuntu/alih-daya-attendance/.env on the VPS.
# Do not commit the real .env file.

# Runtime
NODE_ENV=production

# PostgreSQL container
POSTGRES_DB=alih_daya_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_PASSWORD_DATABASE_YANG_KUAT
DATABASE_URL=postgresql://postgres:GANTI_PASSWORD_DATABASE_YANG_KUAT@postgres:5432/alih_daya_attendance?schema=public

# Auth
# Generate with: openssl rand -base64 48
JWT_SECRET=GANTI_RANDOM_SECRET_MINIMAL_32_KARAKTER
JWT_REFRESH_SECRET=GANTI_RANDOM_REFRESH_SECRET_MINIMAL_32_KARAKTER
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Public API/upload URL
# Use your API domain if available. If you still use IP:8088, set:
# APP_URL=http://YOUR_VPS_IP:8088
APP_URL=https://api.financialku.online

# Uploads
# Production recommendation: use cloudinary.
# If UPLOAD_STORAGE=local, keep uploads_data Docker volume backed up.
UPLOAD_STORAGE=local
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alih-daya-attendance

# Backend app
PORT=3000
BACKEND_PORT=3100

# Admin web
ADMIN_WEB_PORT=3101
ADMIN_WEB_API_BASE_URL=/api/backend
# Use Docker internal backend URL for Next.js rewrite.
ADMIN_WEB_API_UPSTREAM_URL=http://backend:3000/api/v1

# Mobile APK default API URL
MOBILE_API_BASE_URL=https://api.financialku.online/api/v1

# Nginx API/uploads gateway
NGINX_HTTP_PORT=8088

# Security
# If admin web is opened directly on port 3101, include that origin too:
# CORS_ORIGIN=https://api.financialku.online,http://YOUR_VPS_IP:3101
CORS_ORIGIN=https://api.financialku.online
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=

# Seed
# Keep false in production. Use true only for local/demo UAT.
INCLUDE_DEMO_DATA=false
DEMO_PASSWORD=
