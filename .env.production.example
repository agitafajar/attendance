POSTGRES_DB=alih_daya_attendance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_database_password
DATABASE_URL=postgresql://postgres:change_this_database_password@postgres:5432/alih_daya_attendance?schema=public

JWT_SECRET=replace_with_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

APP_URL=https://attendance.example.com
# Prefer cloudinary for production. If local, make sure UPLOAD_DIR is mounted and backed up.
UPLOAD_STORAGE=local
UPLOAD_DIR=/app/uploads
UPLOAD_MAX_SIZE_MB=5
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=alih-daya-attendance
PORT=3000
CORS_ORIGIN=https://attendance.example.com
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=
INCLUDE_DEMO_DATA=false
DEMO_PASSWORD=

BACKEND_PORT=3100
ADMIN_WEB_PORT=3101
ADMIN_WEB_API_BASE_URL=/api/backend
ADMIN_WEB_API_UPSTREAM_URL=https://api.financialku.online/api/v1
MOBILE_API_BASE_URL=https://api.financialku.online/api/v1
NGINX_HTTP_PORT=8088
